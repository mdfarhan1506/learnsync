# Database URL (SQLite default or PostgreSQL connection string on Railway)
DATABASE_URL="file:./prisma/learnsync.db"

# JWT Secret for authentication tokens
JWT_SECRET="learnsync-super-secret-jwt-key-2024-hackathon"
JWT_REFRESH_SECRET="learnsync-refresh-secret-2024"

# Port (Railway provides PORT dynamically)
PORT=3001

# Allowed Frontend Origin for CORS (e.g. https://learnsync-frontend.up.railway.app)
FRONTEND_URL="http://localhost:3000,http://localhost:5173"

# Optional: OpenAI API Key for real LLM integration (fallback to Mock AI if omitted)
# OPENAI_API_KEY="sk-..."
