# Database URL (SQLite file or PostgreSQL connection string)
# For Render persistent disk or local SQLite:
DATABASE_URL="file:./prisma/learnsync.db"
# For Render PostgreSQL (if using external Managed Postgres):
# DATABASE_URL="postgresql://user:password@hostname:5432/learnsync?sslmode=require"

# JWT Secret for authentication tokens
JWT_SECRET="learnsync-super-secret-jwt-key-2024-hackathon"
JWT_REFRESH_SECRET="learnsync-refresh-secret-2024"

# Port (Render dynamically assigns PORT)
PORT=3001

# Allowed Frontend Origins for CORS (comma-separated or * for wildcard)
# e.g. https://learnsync-frontend.onrender.com,http://localhost:3000
FRONTEND_URL="*"

# Optional: OpenAI API Key for live AI generation (uses Mock AI if omitted)
# OPENAI_API_KEY="sk-..."
